# Public application configuration (required at build time)
# Production: https://niaapp.app; use http://localhost:3000 locally
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Trusted server credentials (never expose with NEXT_PUBLIC_)
# Required for the server-side account deletion endpoint, and trusted tooling
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional GIF search; static fallback GIFs are used when omitted
NEXT_PUBLIC_TENOR_API_KEY=

# Seed script only
SUPABASE_URL=https://your-project.supabase.co
PEXELS_API_KEY=
SUPABASE_BUCKET=flicks

# Playwright database fixtures (use only with a local or isolated staging project)
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_ALLOW_REMOTE=false

# Enable only after configuring and testing Google in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# A real, monitored mailbox (create it with an email provider before setting this)
NEXT_PUBLIC_SUPPORT_EMAIL=
