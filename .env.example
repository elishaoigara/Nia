# Public application configuration (required at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Trusted server credentials (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional GIF search; static fallback GIFs are used when omitted
NEXT_PUBLIC_TENOR_API_KEY=

# M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
# Generate a long random value, for example: openssl rand -hex 32
MPESA_CALLBACK_TOKEN=replace-with-a-random-secret

# Seed script only
SUPABASE_URL=https://your-project.supabase.co
PEXELS_API_KEY=
SUPABASE_BUCKET=flicks

# Playwright database fixtures (use only with a local or isolated staging project)
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_ALLOW_REMOTE=false
